{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "title": "Triami",
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1200px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": false,
      "palette": [
        {
          "slug": "triami-rood",
          "name": "Triami-rood",
          "color": "#ED1E24"
        },
        {
          "slug": "triami-rood-donker",
          "name": "Triami-rood donker",
          "color": "#C4151B"
        },
        {
          "slug": "triami-rood-licht",
          "name": "Triami-rood licht",
          "color": "#F36B6F"
        },
        {
          "slug": "triami-rood-tint",
          "name": "Triami-rood tint",
          "color": "#FDE8E8"
        },
        {
          "slug": "zwart",
          "name": "Zwart",
          "color": "#111111"
        },
        {
          "slug": "tekst",
          "name": "Tekst",
          "color": "#1F1F1F"
        },
        {
          "slug": "tekst-gedempt",
          "name": "Tekst gedempt",
          "color": "#5C5C5C"
        },
        {
          "slug": "lijn",
          "name": "Lijn",
          "color": "#DFDFDF"
        },
        {
          "slug": "achtergrond-zacht",
          "name": "Achtergrond zacht",
          "color": "#F4F4F4"
        },
        {
          "slug": "wit",
          "name": "Wit",
          "color": "#FFFFFF"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "kop",
          "name": "Montserrat (koppen)",
          "fontFamily": "\"Montserrat\", Arial, Helvetica, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Montserrat",
              "fontStyle": "normal",
              "fontWeight": "700 800",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/montserrat-latin.woff2"
              ]
            }
          ]
        },
        {
          "slug": "body",
          "name": "Source Sans 3 (tekst)",
          "fontFamily": "\"Source Sans 3\", \"Segoe UI\", system-ui, -apple-system, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Source Sans 3",
              "fontStyle": "normal",
              "fontWeight": "400 600",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/source-sans-3-latin.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "klein",
          "name": "Klein",
          "size": "0.875rem"
        },
        {
          "slug": "normaal",
          "name": "Normaal",
          "size": "1.0625rem"
        },
        {
          "slug": "groot",
          "name": "Groot",
          "size": "1.25rem",
          "fluid": {
            "min": "1.125rem",
            "max": "1.25rem"
          }
        },
        {
          "slug": "xl",
          "name": "XL",
          "size": "1.5625rem",
          "fluid": {
            "min": "1.375rem",
            "max": "1.5625rem"
          }
        },
        {
          "slug": "xxl",
          "name": "XXL",
          "size": "2rem",
          "fluid": {
            "min": "1.625rem",
            "max": "2rem"
          }
        },
        {
          "slug": "xxxl",
          "name": "XXXL",
          "size": "2.75rem",
          "fluid": {
            "min": "2rem",
            "max": "2.75rem"
          }
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "%",
        "vw"
      ],
      "spacingSizes": [
        {
          "slug": "10",
          "name": "1",
          "size": "0.25rem"
        },
        {
          "slug": "20",
          "name": "2",
          "size": "0.5rem"
        },
        {
          "slug": "30",
          "name": "3",
          "size": "1rem"
        },
        {
          "slug": "40",
          "name": "4",
          "size": "1.5rem"
        },
        {
          "slug": "50",
          "name": "5",
          "size": "2rem"
        },
        {
          "slug": "60",
          "name": "6",
          "size": "3rem"
        },
        {
          "slug": "70",
          "name": "7",
          "size": "4rem"
        },
        {
          "slug": "80",
          "name": "8",
          "size": "6rem"
        }
      ]
    },
    "custom": {
      "radius": {
        "klein": "4px",
        "normaal": "8px",
        "pil": "999px"
      },
      "schaduw": "0 2px 8px rgba(0,0,0,.08)"
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--wit)",
      "text": "var(--wp--preset--color--tekst)"
    },
    "spacing": {
      "padding": {
        "left": "max(1rem, env(safe-area-inset-left, 0px))",
        "right": "max(1rem, env(safe-area-inset-right, 0px))",
        "top": "0",
        "bottom": "0"
      },
      "blockGap": "1.5rem"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--normaal)",
      "lineHeight": "1.6"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--kop)",
          "fontWeight": "800",
          "lineHeight": "1.15"
        },
        "color": {
          "text": "var(--wp--preset--color--zwart)"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xxxl)",
          "textTransform": "uppercase",
          "letterSpacing": "0.02em"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xxl)",
          "textTransform": "uppercase",
          "letterSpacing": "0.02em"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xl)"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--groot)",
          "fontWeight": "700"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--triami-rood-donker)"
        },
        "typography": {
          "textDecoration": "underline"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--zwart)"
          }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--triami-rood)",
          "text": "var(--wp--preset--color--wit)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--kop)",
          "fontWeight": "700",
          "fontSize": "1rem",
          "textDecoration": "none"
        },
        "border": {
          "radius": "8px",
          "width": "0"
        },
        "spacing": {
          "padding": {
            "top": "0.75rem",
            "bottom": "0.75rem",
            "left": "1.5rem",
            "right": "1.5rem"
          }
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--triami-rood-donker)",
            "text": "var(--wp--preset--color--wit)"
          }
        },
        ":focus": {
          "color": {
            "background": "var(--wp--preset--color--triami-rood-donker)",
            "text": "var(--wp--preset--color--wit)"
          }
        }
      },
      "caption": {
        "color": {
          "text": "var(--wp--preset--color--tekst-gedempt)"
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--klein)"
        }
      }
    },
    "blocks": {
      "core/navigation": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--kop)",
          "fontWeight": "700",
          "fontSize": "0.875rem",
          "textTransform": "uppercase",
          "letterSpacing": "0.04em"
        },
        "elements": {
          "link": {
            "typography": {
              "textDecoration": "none"
            },
            "color": {
              "text": "var(--wp--preset--color--zwart)"
            },
            ":hover": {
              "color": {
                "text": "var(--wp--preset--color--triami-rood-donker)"
              }
            }
          }
        }
      },
      "core/separator": {
        "color": {
          "text": "var(--wp--preset--color--lijn)"
        },
        "border": {
          "width": "0 0 1px 0"
        }
      },
      "core/quote": {
        "border": {
          "left": {
            "color": "var(--wp--preset--color--triami-rood)",
            "width": "4px",
            "style": "solid"
          }
        },
        "spacing": {
          "padding": {
            "left": "1.25rem"
          }
        }
      },
      "core/details": {
        "border": {
          "bottom": {
            "color": "var(--wp--preset--color--lijn)",
            "width": "1px",
            "style": "solid"
          }
        },
        "spacing": {
          "padding": {
            "top": "0.75rem",
            "bottom": "0.75rem"
          }
        }
      },
      "core/table": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--klein)"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ]
}
